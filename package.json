{
  "name": "copilot-scheduler",
  "displayName": "Copilot Scheduler",
  "description": "Schedule recurring and one-time AI prompts in VS Code",
  "version": "1.18.0",
  "publisher": "yamapan",
  "license": "CC-BY-NC-SA-4.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aktsmm/vscode-copilot-scheduler"
  },
  "bugs": {
    "url": "https://github.com/aktsmm/vscode-copilot-scheduler/issues"
  },
  "homepage": "https://github.com/aktsmm/vscode-copilot-scheduler#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "scheduler",
    "cron",
    "automation",
    "prompt"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "copilot-scheduler-configured",
        "displayName": "%provider.configuredModels%"
      }
    ],
    "commands": [
      {
        "command": "copilotScheduler.createTask",
        "title": "%command.createTask%",
        "category": "%extension.title%"
      },
      {
        "command": "copilotScheduler.createTaskGui",
        "title": "%command.createTaskGui%",
        "category": "%extension.title%",
        "icon": "$(add)"
      },
      {
        "command": "copilotScheduler.listTasks",
        "title": "%command.listTasks%",
        "category": "%extension.title%"
      },
      {
        "command": "copilotScheduler.deleteTask",
        "title": "%command.deleteTask%",
        "category": "%extension.title%",
        "icon": "$(trash)"
      },
      {
        "command": "copilotScheduler.toggleTask",
        "title": "%command.toggleTask%",
        "category": "%extension.title%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "copilotScheduler.enableTask",
        "title": "%command.enableTask%",
        "category": "%extension.title%",
        "icon": "$(play-circle)"
      },
      {
        "command": "copilotScheduler.disableTask",
        "title": "%command.disableTask%",
        "category": "%extension.title%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "copilotScheduler.runNow",
        "title": "%command.runNow%",
        "category": "%extension.title%",
        "icon": "$(play)"
      },
      {
        "command": "copilotScheduler.copyPrompt",
        "title": "%command.copyPrompt%",
        "category": "%extension.title%",
        "icon": "$(copy)"
      },
      {
        "command": "copilotScheduler.editTask",
        "title": "%command.editTask%",
        "category": "%extension.title%",
        "icon": "$(edit)"
      },
      {
        "command": "copilotScheduler.duplicateTask",
        "title": "%command.duplicateTask%",
        "category": "%extension.title%"
      },
      {
        "command": "copilotScheduler.moveToCurrentWorkspace",
        "title": "%command.moveToCurrentWorkspace%",
        "category": "%extension.title%",
        "icon": "$(pin)"
      },
      {
        "command": "copilotScheduler.openSettings",
        "title": "%command.openSettings%",
        "category": "%extension.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "copilotScheduler.showVersion",
        "title": "%command.showVersion%",
        "category": "%extension.title%",
        "icon": "$(info)"
      },
      {
        "command": "copilotScheduler.showExecutionHistory",
        "title": "%command.showExecutionHistory%",
        "category": "%extension.title%",
        "icon": "$(history)"
      },
      {
        "command": "copilotScheduler.dumpModelCatalog",
        "title": "%command.dumpModelCatalog%",
        "category": "%extension.title%"
      }
    ],
    "configuration": {
      "title": "%extension.title%",
      "properties": {
        "copilotScheduler.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "copilotScheduler.defaultScope": {
          "type": "string",
          "default": "workspace",
          "enum": [
            "global",
            "workspace"
          ],
          "enumDescriptions": [
            "%config.defaultScope.global%",
            "%config.defaultScope.workspace%"
          ],
          "description": "%config.defaultScope%"
        },
        "copilotScheduler.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.ja%"
          ],
          "description": "%config.language%"
        },
        "copilotScheduler.timezone": {
          "type": "string",
          "default": "",
          "description": "%config.timezone%"
        },
        "copilotScheduler.jitterSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "maximum": 1800,
          "description": "%config.jitterSeconds%"
        },
        "copilotScheduler.manualRunNextRunPolicy": {
          "type": "string",
          "default": "fromNow",
          "enum": [
            "fromNow",
            "advance"
          ],
          "enumDescriptions": [
            "%config.manualRunNextRunPolicy.fromNow%",
            "%config.manualRunNextRunPolicy.advance%"
          ],
          "description": "%config.manualRunNextRunPolicy%"
        },
        "copilotScheduler.missedRunPolicy": {
          "type": "string",
          "default": "runOnce",
          "enum": [
            "runOnce",
            "skip"
          ],
          "enumDescriptions": [
            "%config.missedRunPolicy.runOnce%",
            "%config.missedRunPolicy.skip%"
          ],
          "description": "%config.missedRunPolicy%"
        },
        "copilotScheduler.chatSession": {
          "type": "string",
          "default": "new",
          "enum": [
            "new",
            "continue"
          ],
          "enumDescriptions": [
            "%config.chatSession.new%",
            "%config.chatSession.continue%"
          ],
          "description": "%config.chatSession%"
        },
        "copilotScheduler.skillTemplates": {
          "type": "string",
          "default": "explicit",
          "enum": [
            "explicit",
            "all",
            "off"
          ],
          "enumDescriptions": [
            "%config.skillTemplates.explicit%",
            "%config.skillTemplates.all%",
            "%config.skillTemplates.off%"
          ],
          "markdownDescription": "%config.skillTemplates%"
        },
        "copilotScheduler.sessionHarness": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "local"
          ],
          "enumDescriptions": [
            "%config.sessionHarness.auto%",
            "%config.sessionHarness.local%"
          ],
          "markdownDescription": "%config.sessionHarness%"
        },
        "copilotScheduler.executionRoute": {
          "type": "string",
          "default": "agentHost",
          "enum": [
            "agentHost",
            "chat"
          ],
          "enumDescriptions": [
            "%config.executionRoute.agentHost%",
            "%config.executionRoute.chat%"
          ],
          "markdownDescription": "%config.executionRoute%"
        },
        "copilotScheduler.executionFallback": {
          "type": "string",
          "default": "chat",
          "enum": [
            "chat",
            "fail"
          ],
          "enumDescriptions": [
            "%config.executionFallback.chat%",
            "%config.executionFallback.fail%"
          ],
          "markdownDescription": "%config.executionFallback%"
        },
        "copilotScheduler.agentHostAutoApprove": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%config.agentHostAutoApprove%"
        },
        "copilotScheduler.agentHostOpenSession": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.agentHostOpenSession%"
        },
        "copilotScheduler.agentHostTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 720,
          "scope": "machine",
          "markdownDescription": "%config.agentHostTimeoutMinutes%"
        },
        "copilotScheduler.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.cliPath%"
        },
        "copilotScheduler.cliAllowAllTools": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%config.cliAllowAllTools%"
        },
        "copilotScheduler.cliTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 720,
          "scope": "machine",
          "markdownDescription": "%config.cliTimeoutMinutes%"
        },
        "copilotScheduler.showCopilotCliControls": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%config.showCopilotCliControls%"
        },
        "copilotScheduler.autoModeDefault": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.autoModeDefault%"
        },
        "copilotScheduler.modelFallbackChain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "default": [
            "hydrafusion",
            "auto"
          ],
          "markdownDescription": "%config.modelFallbackChain%"
        },
        "copilotScheduler.commandDelayFactor": {
          "type": "number",
          "default": 0.8,
          "minimum": 0.1,
          "maximum": 2,
          "description": "%config.commandDelayFactor%"
        },
        "copilotScheduler.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.showNotifications%"
        },
        "copilotScheduler.notificationMode": {
          "type": "string",
          "default": "sound",
          "enum": [
            "sound",
            "silentToast",
            "silentStatus"
          ],
          "enumDescriptions": [
            "%config.notificationMode.sound%",
            "%config.notificationMode.silentToast%",
            "%config.notificationMode.silentStatus%"
          ],
          "description": "%config.notificationMode%"
        },
        "copilotScheduler.maxDailyExecutions": {
          "type": "integer",
          "default": 24,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.maxDailyExecutions%"
        },
        "copilotScheduler.minimumIntervalWarning": {
          "type": "boolean",
          "default": true,
          "description": "%config.minimumIntervalWarning%"
        },
        "copilotScheduler.globalPromptsPath": {
          "type": "string",
          "default": "",
          "description": "%config.globalPromptsPath%"
        },
        "copilotScheduler.globalAgentsPath": {
          "type": "string",
          "default": "",
          "description": "%config.globalAgentsPath%"
        },
        "copilotScheduler.promptFileFallback": {
          "type": "string",
          "default": "snapshot",
          "enum": [
            "snapshot",
            "blockWhenResolvable",
            "blockAlways"
          ],
          "enumDescriptions": [
            "%config.promptFileFallback.snapshot%",
            "%config.promptFileFallback.blockWhenResolvable%",
            "%config.promptFileFallback.blockAlways%"
          ],
          "description": "%config.promptFileFallback%"
        },
        "copilotScheduler.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "none",
            "error",
            "info",
            "debug"
          ],
          "enumDescriptions": [
            "%config.logLevel.none%",
            "%config.logLevel.error%",
            "%config.logLevel.info%",
            "%config.logLevel.debug%"
          ],
          "description": "%config.logLevel%"
        },
        "copilotScheduler.executionHistoryLimit": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 500,
          "description": "%config.executionHistoryLimit%"
        },
        "copilotScheduler.lmTools.enableWriteTools": {
          "type": "boolean",
          "default": true,
          "description": "%config.lmTools.enableWriteTools%"
        },
        "copilotScheduler.lmTools.confirmationMode": {
          "type": "string",
          "default": "destructiveOnly",
          "enum": [
            "always",
            "destructiveOnly",
            "minimal"
          ],
          "enumDescriptions": [
            "%config.lmTools.confirmationMode.always%",
            "%config.lmTools.confirmationMode.destructiveOnly%",
            "%config.lmTools.confirmationMode.minimal%"
          ],
          "description": "%config.lmTools.confirmationMode%"
        },
        "copilotScheduler.reportIssue": {
          "type": "null",
          "markdownDescription": "%config.reportIssue%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "scheduler_query",
        "displayName": "%tool.scheduler_query.displayName%",
        "modelDescription": "%tool.scheduler_query.modelDescription%",
        "toolReferenceName": "scheduler_query",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-tree)",
        "tags": [
          "copilot-scheduler"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "history",
                "preview_cron",
                "list_models",
                "list_agent_host_models",
                "list_agents",
                "list_skills",
                "list_sessions"
              ],
              "description": "Which kind of read to perform. Use list_models before setting 'model', list_agent_host_models before setting 'agentHostModelId', list_agents before setting 'agent', list_skills before writing a '/<skill>' prompt, and list_sessions before binding a task to an existing Copilot chat. Never infer an Agent Host ID from another catalog."
            },
            "scope": {
              "type": "string",
              "enum": [
                "global",
                "workspace",
                "all"
              ],
              "description": "For kind=list. Filter by task scope."
            },
            "enabledOnly": {
              "type": "boolean",
              "description": "For kind=list. Return only enabled tasks when true."
            },
            "id": {
              "type": "string",
              "description": "For kind=get. Task id to fetch."
            },
            "taskId": {
              "type": "string",
              "description": "For kind=history. Filter history entries to this task id."
            },
            "limit": {
              "type": "number",
              "description": "For kind=history. Max entries to return (1-500).",
              "minimum": 1,
              "maximum": 500
            },
            "cronExpression": {
              "type": "string",
              "description": "For kind=preview_cron. Cron expression to evaluate (multi-schedule supported when separated by newlines)."
            },
            "count": {
              "type": "number",
              "description": "For kind=preview_cron. Number of next occurrences (1-20).",
              "minimum": 1,
              "maximum": 20
            },
            "timezone": {
              "type": "string",
              "description": "For kind=preview_cron. IANA timezone (e.g. Asia/Tokyo)."
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      {
        "name": "scheduler_create_task",
        "displayName": "%tool.scheduler_create_task.displayName%",
        "modelDescription": "%tool.scheduler_create_task.modelDescription%",
        "toolReferenceName": "scheduler_create_task",
        "canBeReferencedInPrompt": true,
        "icon": "$(add)",
        "tags": [
          "copilot-scheduler"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Human-readable task name."
            },
            "cronExpression": {
              "type": "string",
              "description": "Cron expression for recurring tasks. Omit when runAt is set. Supports multiple lines separated by newlines."
            },
            "runAt": {
              "type": "string",
              "description": "One-time execution instant as ISO 8601 with explicit timezone offset, e.g. 2026-09-26T21:00:00+09:00. Mutually exclusive with cronExpression."
            },
            "afterRun": {
              "type": "string",
              "enum": [
                "disable",
                "delete"
              ],
              "description": "After a one-time task is dispatched, disable it (default) or delete it after its history is saved. Requires runAt."
            },
            "scope": {
              "type": "string",
              "enum": [
                "global",
                "workspace"
              ],
              "description": "Where the task lives. workspace requires an open folder."
            },
            "promptSource": {
              "type": "string",
              "enum": [
                "inline",
                "local",
                "global"
              ],
              "description": "Where the prompt comes from. Defaults to 'inline'."
            },
            "prompt": {
              "type": "string",
              "description": "Prompt text sent to Copilot. Always required, even when promptSource is 'local' or 'global' (use the file content)."
            },
            "promptPath": {
              "type": "string",
              "description": "Required when promptSource is 'local' or 'global'. Path relative to the resolved prompts root."
            },
            "agent": {
              "type": "string",
              "description": "Agent to use (e.g. '@workspace', 'agent', 'ask', 'edit'). Call scheduler_query with kind=list_agents to discover valid ids."
            },
            "model": {
              "type": "string",
              "description": "AI model id for this task. Use an 'id' returned by scheduler_query kind=list_models. Omit or pass an empty string to use the default model."
            },
            "modelVendor": {
              "type": "string",
              "description": "Provider identity from scheduler_query kind=list_models (vendor). Required when multiple providers offer the same model id. Preserved during resolution and dispatch."
            },
            "agentHostModelId": {
              "type": "string",
              "description": "Exact opaque id explicitly selected from scheduler_query kind=list_agent_host_models. Copy it unchanged; never infer or construct it from model, vendor, name, or a suffix. The catalog does not verify correspondence with model; if unclear, ask the user to select the matching ID. Omit when no Agent Host ID is selected."
            },
            "modelConfiguration": {
              "type": "object",
              "description": "Model-specific enum values from list_models configurationOptions. Empty object inherits shared Chat settings. Explicit options execute through a fixed per-request model on VS Code 1.141 or later without changing shared settings. Requires source-provider authorization. Do not combine with modelReasoningEffort.",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string"
                },
                "reasoningEffort": {
                  "type": "string"
                },
                "speedMode": {
                  "type": "string"
                },
                "contextSize": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "modelReasoningEffort": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "description": "Experimental reasoning effort. Only send a value listed in 'supportedReasoningEfforts' for the chosen model in scheduler_query kind=list_models; unsupported values are dropped with a warning."
            },
            "enabled": {
              "type": "boolean",
              "description": "Whether the task is enabled after creation. Defaults to true. Enabling requires the disclaimer to be accepted."
            },
            "chatSession": {
              "type": "string",
              "enum": [
                "default",
                "new",
                "continue"
              ],
              "description": "Per-task chat session override. 'default' uses the global setting."
            },
            "agentHostWorkspaceMode": {
              "type": "string",
              "enum": [
                "default",
                "folder",
                "worktree"
              ],
              "description": "Location for NEW Agent Host sessions only. folder shares the existing folder, including uncommitted changes and local records; worktree requests a new Git worktree. Omitted/default preserves previous Host behavior (normally worktree for Git). Resume keeps the original location without forcing a new session. Inactive for bound existing chats and actual CLI runs; saved values are retained. If an applicable explicit choice cannot be honored, the prompt is not sent."
            },
            "targetChatId": {
              "type": "string",
              "description": "Optional opaque bindingId returned by scheduler_query kind=list_sessions. Queues this task in that existing Copilot chat. Call list_sessions first; never guess or use an internal URI. Workspace tasks must match the selected chat's sole workspace."
            },
            "autoMode": {
              "type": "boolean",
              "description": "Prepend an autonomous-execution hint to the runtime prompt. Defaults to the copilotScheduler.autoModeDefault setting."
            },
            "modelFallback": {
              "type": "boolean",
              "description": "Enable task-level model fallback before dispatch when the selected model is absent. Defaults to false when omitted by this tool. Without an explicit policy, Chat prefers a replacement from a different provider and family; Agent Host needs an explicit replacement ID, which can be set in the task editor."
            },
            "preventAgentHostFallback": {
              "type": "boolean",
              "description": "When true, block fallback from Agent Host to Chat. Default false; existing fallback policy still applies. Does not affect routes initially selected as Chat, Local, remote, or CLI. Independent of modelFallback, which changes models."
            },
            "jitterSeconds": {
              "type": "number",
              "description": "Max random delay in seconds before execution (0 = off). Spreads out runs to reduce rate-limit risk. Defaults to the copilotScheduler.jitterSeconds setting.",
              "minimum": 0,
              "maximum": 1800
            },
            "maxExecutionsPerDay": {
              "type": "number",
              "description": "Per-task execution cap per day (0 = unlimited).",
              "minimum": 0
            },
            "allowOverlappingRuns": {
              "type": "boolean",
              "default": false,
              "description": "Allow overlapping automatic occurrences of this recurring task. Default false. Manual runs and one-time tasks keep their existing guards; runs using the same chat may queue."
            },
            "allowedTimeStart": {
              "type": "string",
              "description": "Earliest wall-clock time the task may run, as 'HH:mm', read in the scheduler timezone."
            },
            "allowedTimeEnd": {
              "type": "string",
              "description": "Latest wall-clock time the task may run, as 'HH:mm', read in the scheduler timezone."
            },
            "attachments": {
              "type": "array",
              "description": "Files attached to the chat request when the task runs. Every attachment must resolve at run time or the task is skipped. Only workspace-scoped tasks may use source 'local'.",
              "maxItems": 10,
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "local",
                      "global"
                    ],
                    "description": "'local' resolves against the task's workspace folder, 'global' against the global prompts folder."
                  },
                  "path": {
                    "type": "string",
                    "description": "Path relative to the source root, e.g. '.github/instructions/style.instructions.md'. Absolute paths and '..' are rejected."
                  }
                },
                "required": [
                  "source",
                  "path"
                ]
              }
            }
          },
          "required": [
            "name",
            "prompt",
            "scope"
          ]
        }
      },
      {
        "name": "scheduler_update_task",
        "displayName": "%tool.scheduler_update_task.displayName%",
        "modelDescription": "%tool.scheduler_update_task.modelDescription%",
        "toolReferenceName": "scheduler_update_task",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "tags": [
          "copilot-scheduler"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Task id to update."
            },
            "updates": {
              "type": "object",
              "description": "Fields to change. Use scheduler_set_task_enabled to toggle enabled; passing enabled here returns an error.",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "cronExpression": {
                  "type": "string"
                },
                "runAt": {
                  "type": "string",
                  "description": "One-time ISO 8601 instant with timezone offset. Pass an empty string when switching back to cronExpression."
                },
                "afterRun": {
                  "type": "string",
                  "enum": [
                    "disable",
                    "delete"
                  ]
                },
                "promptSource": {
                  "type": "string",
                  "enum": [
                    "inline",
                    "local",
                    "global"
                  ]
                },
                "prompt": {
                  "type": "string"
                },
                "promptPath": {
                  "type": "string"
                },
                "agent": {
                  "type": "string",
                  "description": "Agent to use. Call scheduler_query with kind=list_agents to discover valid ids."
                },
                "model": {
                  "type": "string",
                  "description": "AI model id. Use an 'id' returned by scheduler_query kind=list_models, or an empty string to go back to the default model."
                },
                "modelVendor": {
                  "type": "string",
                  "description": "Provider identity from scheduler_query kind=list_models (vendor). Required when multiple providers offer the same model id. Preserved during resolution and dispatch."
                },
                "agentHostModelId": {
                  "type": "string",
                  "description": "Exact opaque id explicitly selected from scheduler_query kind=list_agent_host_models. Copy it unchanged; never infer or construct it from model, vendor, name, or a suffix. The catalog does not verify correspondence with model; if unclear, ask the user to select the matching ID. Omission preserves the binding when the model identity is unchanged; clearing model clears its binding."
                },
                "modelConfiguration": {
                  "type": "object",
                  "description": "Model enum values from list_models. Omission preserves existing task options; {} clears task overrides and inherits shared Chat settings. Explicit options are fixed per request on VS Code 1.141 or later without shared-setting writes. Do not combine with modelReasoningEffort.",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "type": "string"
                    },
                    "reasoningEffort": {
                      "type": "string"
                    },
                    "speedMode": {
                      "type": "string"
                    },
                    "contextSize": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  }
                },
                "modelReasoningEffort": {
                  "type": "string",
                  "enum": [
                    "none",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ],
                  "description": "Experimental reasoning effort. Only send a value listed in 'supportedReasoningEfforts' for the chosen model; unsupported values are dropped with a warning."
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "global",
                    "workspace"
                  ],
                  "description": "Where the task lives. workspace requires an open folder."
                },
                "chatSession": {
                  "type": "string",
                  "enum": [
                    "default",
                    "new",
                    "continue"
                  ]
                },
                "agentHostWorkspaceMode": {
                  "type": "string",
                  "enum": [
                    "default",
                    "folder",
                    "worktree"
                  ],
                  "description": "Location for NEW Agent Host sessions only. Omission preserves the saved value; default removes the override and restores previous Host behavior (normally worktree for Git). folder shares uncommitted changes and local records; worktree requests a new Git worktree. Resume keeps the original location without forcing a new session. Inactive for bound existing chats and actual CLI runs, retaining the choice. If an applicable explicit choice cannot be honored, the prompt is not sent."
                },
                "targetChatId": {
                  "type": "string",
                  "description": "Set to a bindingId returned by scheduler_query kind=list_sessions to bind the task to an existing Copilot chat. Use an empty string to clear the binding. Workspace tasks must match the selected chat's sole workspace."
                },
                "autoMode": {
                  "type": "boolean",
                  "description": "Prepend an autonomous-execution hint to the runtime prompt."
                },
                "modelFallback": {
                  "type": "boolean",
                  "description": "Enable or disable task-level model fallback before dispatch. Enabling without an existing policy uses the default: Chat prefers a replacement from a different provider and family. Omission preserves the current setting."
                },
                "preventAgentHostFallback": {
                  "type": "boolean",
                  "description": "When true, block fallback from Agent Host to Chat. False leaves existing fallback policy in effect. Does not affect routes initially selected as Chat, Local, remote, or CLI. Independent of modelFallback, which changes models. Omission preserves the current setting."
                },
                "jitterSeconds": {
                  "type": "number",
                  "description": "Max random delay in seconds before execution (0 = off).",
                  "minimum": 0,
                  "maximum": 1800
                },
                "maxExecutionsPerDay": {
                  "type": "number",
                  "description": "Per-task execution cap per day (0 = unlimited).",
                  "minimum": 0
                },
                "allowOverlappingRuns": {
                  "type": "boolean",
                  "description": "Allow overlapping automatic occurrences of this recurring task. Default false; omission preserves the saved value. Manual runs and one-time tasks keep their existing guards; runs using the same chat may queue."
                },
                "allowedTimeStart": {
                  "type": "string",
                  "description": "Earliest wall-clock time the task may run, as 'HH:mm', read in the scheduler timezone."
                },
                "allowedTimeEnd": {
                  "type": "string",
                  "description": "Latest wall-clock time the task may run, as 'HH:mm', read in the scheduler timezone."
                },
                "attachments": {
                  "type": "array",
                  "description": "Replaces the whole attachment list. Every attachment must resolve at run time or the task is skipped. Only workspace-scoped tasks may use source 'local'.",
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "local",
                          "global"
                        ],
                        "description": "'local' resolves against the task's workspace folder, 'global' against the global prompts folder."
                      },
                      "path": {
                        "type": "string",
                        "description": "Path relative to the source root. Absolute paths and '..' are rejected."
                      }
                    },
                    "required": [
                      "source",
                      "path"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "id",
            "updates"
          ]
        }
      },
      {
        "name": "scheduler_delete_task",
        "displayName": "%tool.scheduler_delete_task.displayName%",
        "modelDescription": "%tool.scheduler_delete_task.modelDescription%",
        "toolReferenceName": "scheduler_delete_task",
        "canBeReferencedInPrompt": true,
        "icon": "$(trash)",
        "tags": [
          "copilot-scheduler"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Task id to delete. This is not recoverable."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "scheduler_set_task_enabled",
        "displayName": "%tool.scheduler_set_task_enabled.displayName%",
        "modelDescription": "%tool.scheduler_set_task_enabled.modelDescription%",
        "toolReferenceName": "scheduler_set_task_enabled",
        "canBeReferencedInPrompt": true,
        "icon": "$(check)",
        "tags": [
          "copilot-scheduler"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Task id."
            },
            "enabled": {
              "type": "boolean",
              "description": "True to enable, false to disable."
            }
          },
          "required": [
            "id",
            "enabled"
          ]
        }
      },
      {
        "name": "scheduler_run_task",
        "displayName": "%tool.scheduler_run_task.displayName%",
        "modelDescription": "%tool.scheduler_run_task.modelDescription%",
        "toolReferenceName": "scheduler_run_task",
        "canBeReferencedInPrompt": true,
        "icon": "$(play)",
        "tags": [
          "copilot-scheduler"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Task id to run once immediately. The task's enabled state is not changed."
            }
          },
          "required": [
            "id"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotScheduler",
          "title": "%extension.title%",
          "icon": "images/scheduler-icon.svg"
        }
      ]
    },
    "views": {
      "copilotScheduler": [
        {
          "id": "copilotSchedulerTasks",
          "name": "%view.tasks%",
          "icon": "images/scheduler-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilotScheduler.createTaskGui",
          "when": "view == copilotSchedulerTasks",
          "group": "navigation@1"
        },
        {
          "command": "copilotScheduler.openSettings",
          "when": "view == copilotSchedulerTasks",
          "group": "navigation@2"
        },
        {
          "command": "copilotScheduler.showExecutionHistory",
          "when": "view == copilotSchedulerTasks",
          "group": "navigation@3"
        },
        {
          "command": "copilotScheduler.showVersion",
          "when": "view == copilotSchedulerTasks",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "copilotScheduler.disableTask",
          "when": "view == copilotSchedulerTasks && (viewItem == enabledTask || viewItem == enabledWorkspaceTask || viewItem == enabledOtherWorkspaceTask)",
          "group": "inline@1"
        },
        {
          "command": "copilotScheduler.enableTask",
          "when": "view == copilotSchedulerTasks && (viewItem == disabledTask || viewItem == disabledWorkspaceTask || viewItem == disabledOtherWorkspaceTask)",
          "group": "inline@1"
        },
        {
          "command": "copilotScheduler.runNow",
          "when": "view == copilotSchedulerTasks && viewItem =~ /Task$/",
          "group": "inline@2"
        },
        {
          "command": "copilotScheduler.copyPrompt",
          "when": "view == copilotSchedulerTasks && viewItem =~ /Task$/",
          "group": "inline@3"
        },
        {
          "command": "copilotScheduler.editTask",
          "when": "view == copilotSchedulerTasks && viewItem =~ /Task$/",
          "group": "inline@4"
        },
        {
          "command": "copilotScheduler.moveToCurrentWorkspace",
          "when": "view == copilotSchedulerTasks && (viewItem == enabledOtherWorkspaceTask || viewItem == disabledOtherWorkspaceTask)",
          "group": "inline@4.5"
        },
        {
          "command": "copilotScheduler.deleteTask",
          "when": "view == copilotSchedulerTasks && (viewItem == enabledTask || viewItem == disabledTask || viewItem == enabledWorkspaceTask || viewItem == disabledWorkspaceTask)",
          "group": "inline@5"
        },
        {
          "command": "copilotScheduler.runNow",
          "when": "view == copilotSchedulerTasks && viewItem =~ /Task$/",
          "group": "1_actions@1"
        },
        {
          "command": "copilotScheduler.toggleTask",
          "when": "view == copilotSchedulerTasks && viewItem =~ /Task$/",
          "group": "1_actions@2"
        },
        {
          "command": "copilotScheduler.editTask",
          "when": "view == copilotSchedulerTasks && viewItem =~ /Task$/",
          "group": "2_edit@1"
        },
        {
          "command": "copilotScheduler.duplicateTask",
          "when": "view == copilotSchedulerTasks && viewItem =~ /Task$/",
          "group": "2_edit@2"
        },
        {
          "command": "copilotScheduler.moveToCurrentWorkspace",
          "when": "view == copilotSchedulerTasks && (viewItem == enabledOtherWorkspaceTask || viewItem == disabledOtherWorkspaceTask)",
          "group": "2_edit@3"
        },
        {
          "command": "copilotScheduler.deleteTask",
          "when": "view == copilotSchedulerTasks && (viewItem == enabledTask || viewItem == disabledTask || viewItem == enabledWorkspaceTask || viewItem == disabledWorkspaceTask)",
          "group": "3_delete@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run esbuild-base -- --sourcemap",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "pretest": "tsc -p ./",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "verify:nls": "node scripts/verify-nls-consistency.js",
    "verify:vsix": "node scripts/verify-vsix-contents.js --verify-build"
  },
  "dependencies": {
    "cron-parser": "^4.9.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.27.2",
    "eslint": "^8.0.0",
    "glob": "^14.0.4",
    "mocha": "^11.7.5",
    "typescript": "^5.0.0",
    "ws": "^8.22.1",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  },
  "overrides": {
    "serialize-javascript": "7.1.4",
    "@vscode/vsce": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "mocha": {
      "minimatch": "11.0.5",
      "glob": "14.0.4"
    },
    "diff": "9.0.0"
  }
}
